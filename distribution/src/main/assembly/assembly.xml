<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>gmp-server</id>
    <formats>
        <format>tar.gz</format>
        <format>dir</format>
    </formats>

    <dependencySets>
        <!-- Every runtime jar, flat under lib/, launched with -cp 'lib/*' -->
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <outputDirectory>/lib</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>target/site/doxygen</directory>
            <outputDirectory>/doc</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>src/main/etc/bin</directory>
            <outputDirectory>/bin</outputDirectory>
            <filtered>true</filtered>
            <includes>
                <include>start.sh</include>
                <include>gmp-server-ctl.sh</include>
                <include>gmp-server</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- Copy startup scripts of any project specific config -->
        <fileSet>
            <directory>../instances/${gmp.instance}/src/main/etc/bin</directory>
            <outputDirectory>/bin</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>../giapi-tester/src/main/etc/bin</directory>
            <outputDirectory>/bin</outputDirectory>
            <includes>
                <include>giapi-tester.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>../giapi-tester/target/</directory>
            <outputDirectory>/bin</outputDirectory>
            <includes>
                <include>giapi-tester.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../gds-config-validator/target/</directory>
            <outputDirectory>/bin</outputDirectory>
            <includes>
                <include>gds-config-validator.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../gds-config-validator/src/main/etc/bin</directory>
            <outputDirectory>/bin</outputDirectory>
            <includes>
                <include>gds-config-validator.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- Copy configurations out of any project specific config -->
        <fileSet>
            <directory>../instances/${gmp.instance}/src/main/config</directory>
            <outputDirectory>/conf</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <!-- Copy configurations out of the top level config directory -->
        <fileSet>
            <directory>../src/main/config</directory>
            <excludes>
                <exclude>gsaoi.xml</exclude>
            </excludes>
            <outputDirectory>/conf</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>src/main/doc</directory>
            <outputDirectory>/</outputDirectory>
            <filtered>true</filtered>
            <includes>
                <include>*.txt</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>src/main/doc</directory>
            <outputDirectory>/</outputDirectory>
            <filtered>true</filtered>
            <includes>
                <include>README</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
