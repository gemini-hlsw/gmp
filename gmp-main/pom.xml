<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <relativePath>../poms/scala/</relativePath>
        <groupId>edu.gemini.aspen.giapi-osgi.build</groupId>
        <artifactId>scala-compiled-bundle-settings</artifactId>
        <version>0.2.7-SNAPSHOT</version>
    </parent>

    <properties>
        <bundle.symbolicName>edu.gemini.aspen.gmp.main</bundle.symbolicName>
        <bundle.namespace>edu.gemini.aspen.gmp.main</bundle.namespace>
        <scala.lib.suffix>2.13</scala.lib.suffix>
    </properties>

    <modelVersion>4.0.0</modelVersion>
    <groupId>edu.gemini.aspen.gmp</groupId>
    <artifactId>gmp-main</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>GMP Main</name>
    <description>Plain-Java composition root and config loader replacing the OSGi container</description>

    <packaging>jar</packaging>

    <build>
        <plugins>
            <!-- Dev launcher replacing `mvn pax:provision`: run from the repo
                 root with `mvn -pl gmp-main exec:java` -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <mainClass>edu.gemini.aspen.gmp.main.GmpMain</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>conf.base</key>
                            <value>${basedir}/../src/main/config</value>
                        </systemProperty>
                        <systemProperty>
                            <key>logs.dir</key>
                            <value>${basedir}/../logs</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>

